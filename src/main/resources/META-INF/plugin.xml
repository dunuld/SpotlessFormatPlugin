<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It cannot be changed between the plugin versions. -->
    <id>de.spotlessformatplugin.SpotlessFormatPlugin</id>

    <name>Spotless Formatter</name>

    <vendor url="https://github.com/dunuld/SpotlessFormatPlugin">SpotlessFormatPlugin</vendor>

    <description><![CDATA[
        Formats files with Spotless-style formatter steps directly in IntelliJ IDEA:
        <ul>
            <li><b>Eclipse formatter</b>: Eclipse JDT formatter XML (with profile selection) and import order files for Java</li>
            <li><b>Google Java Format</b>: bundled google-java-format, optionally removing unused imports and sorting imports</li>
            <li><b>Prettier</b>: project-local or global Prettier installation (trusted projects only)</li>
            <li><b>Generic Spotless steps</b>: trailing whitespace, final newline and optional import order</li>
        </ul>
        Formatting can run as an <i>Action on Save</i> and can optionally replace the <i>Reformat Code</i> action
        for configured file extensions.
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <resource-bundle>messages.SpotlessBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                instance="de.spotlessformatplugin.settings.SpotlessFormatConfigurable"
                id="de.spotlessformatplugin.settings.SpotlessFormatConfigurable"
                key="settings.displayName"
                bundle="messages.SpotlessBundle"/>

        <actionOnSaveInfoProvider implementation="de.spotlessformatplugin.actionsonsave.SpotlessActionOnSaveInfoProvider"/>
        <actionOnSave implementation="de.spotlessformatplugin.actionsonsave.SpotlessActionOnSave"/>

        <notificationGroup id="Spotless Formatter"
                           displayType="BALLOON"
                           key="notification.group.spotless"
                           bundle="messages.SpotlessBundle"/>

        <postStartupActivity implementation="de.spotlessformatplugin.actions.SpotlessReformatActionStartupActivity"/>
    </extensions>
</idea-plugin>
